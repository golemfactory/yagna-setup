# Requestor node for the clock-skew event-loss test.
NODE_NAME=clockskew-requestor

YA_NET_TYPE=central
CENTRAL_NET_HOST=127.0.0.1:7011

RUST_LOG=info
YA_CONSENT_INTERNAL=allow
YA_CONSENT_EXTERNAL=allow

YAGNA_DATADIR=yagnadir

YAGNA_AUTOCONF_APPKEY=clockskewReqKey
YAGNA_APPKEY=clockskewReqKey

GSB_URL=tcp://127.0.0.1:7552
YAGNA_API_URL=http://127.0.0.1:7553

YA_PAYMENT_NETWORK=hoodi
YAGNA_DEV_SKIP_ALLOCATION_VALIDATION=1
