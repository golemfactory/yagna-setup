# Provider node for the clock-skew event-loss test.
NODE_NAME=clockskew-provider

YA_NET_TYPE=central
# Router port is private to this test; run_test.sh rewrites it if ROUTER_PORT is overridden.
CENTRAL_NET_HOST=127.0.0.1:7011

RUST_LOG=info,ya_provider=debug
YA_CONSENT_INTERNAL=allow
YA_CONSENT_EXTERNAL=allow

YA_PAYMENT_NETWORK=hoodi
DISABLE_AUTO_CLEANUP=true

YAGNA_DATADIR=yagnadir
DATA_DIR=providerdir

GSB_URL=tcp://127.0.0.1:7540
YAGNA_API_URL=http://127.0.0.1:7541

YAGNA_AUTOCONF_APPKEY=clockskewProvKey
YAGNA_APPKEY=clockskewProvKey
